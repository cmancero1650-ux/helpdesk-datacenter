{
  "database": "helpdesk_datacenter",
  "engine": "PostgreSQL",
  "table": "tickets",
  "attributes": {
    "id": "SERIAL PRIMARY KEY",
    "titulo": "VARCHAR(120) NOT NULL",
    "descripcion": "TEXT NOT NULL",
    "categoria": "VARCHAR(20) CHECK Red, Hardware, Software",
    "prioridad": "VARCHAR(10) CHECK Alta, Media, Baja",
    "estado": "VARCHAR(20) CHECK Abierto, En Progreso, Cerrado",
    "created_at": "TIMESTAMP DEFAULT NOW()",
    "updated_at": "TIMESTAMP DEFAULT NOW()"
  }
}
